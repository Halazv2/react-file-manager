{
  "name": "@halazv2/react-file-manager",
  "version": "0.4.2",
  "description": "Headless-ish React file browser with Finder-style spring-loaded folders and drag-and-drop.",
  "type": "module",
  "license": "MIT",
  "author": "halazv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Halazv2/react-file-manager.git"
  },
  "homepage": "https://halazv2.github.io/react-file-manager/",
  "bugs": {
    "url": "https://github.com/halazv2/react-file-manager/issues"
  },
  "keywords": [
    "react",
    "file-manager",
    "file-browser",
    "finder",
    "drag-and-drop",
    "spring-loaded"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "require": "./dist/preview.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/react-file-manager.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.lib.ts && npm run build:css",
    "build:css": "cp ./src/theme.css ./dist/styles.css && cp ./src/theme.css ./dist/react-file-manager.css",
    "build:demo": "vite build",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src demo eslint.config.js",
    "format": "prettier --check .",
    "capture:gif": "node scripts/capture-spring-gif.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13"
  }
}
